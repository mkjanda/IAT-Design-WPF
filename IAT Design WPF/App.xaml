<Application x:Class="IAT_Design_WPF.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/StringDictionary.xaml" />
                <!-- Shell theme tokens, animations, tab style -->
                <ResourceDictionary Source="/Styles/Styles.xaml"/>
                <!-- Control styles (AccentButton, DarkTextBox, DarkComboBox) + converters -->
                <ResourceDictionary Source="/IAT.Views;component/Resources/ViewStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
