<Window x:Class="IAT.Views.NotificationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Notification"
        Background="#252526"
        Foreground="#E0E0E0"
        FontFamily="Segoe UI"
        FontSize="13"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        SizeToContent="Height"
        Width="480"
        MinHeight="160"
        MaxHeight="420"
        ShowInTaskbar="False"
        SnapsToDevicePixels="True">

    <Window.Resources>
        <Style x:Key="DialogPrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#007ACC"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="22,8"/>
            <Setter Property="MinWidth" Value="96"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1C8AD4"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#0E639C"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border BorderBrush="#3C3C3C" BorderThickness="1" Background="#252526">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Accent title bar -->
            <Border Grid.Row="0" Background="#2D2D2D" BorderBrush="#3C3C3C" BorderThickness="0,0,0,1"
                    Padding="18,14">
                <DockPanel>
                    <Border Width="4" Background="#007ACC" CornerRadius="2" Margin="0,0,14,0"
                            VerticalAlignment="Stretch"/>
                    <TextBlock Text="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=Title}"
                               FontSize="15" FontWeight="SemiBold"
                               Foreground="#FFFFFF"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"/>
                </DockPanel>
            </Border>

            <!-- Message body — fixed width + wrap; scroll only if unusually long -->
            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          MaxHeight="260"
                          Margin="0">
                <TextBlock Text="{Binding Message}"
                           Margin="22,18,22,14"
                           TextWrapping="Wrap"
                           Foreground="#E8E8E8"
                           FontSize="14"
                           LineHeight="22"/>
            </ScrollViewer>

            <!-- Actions -->
            <Border Grid.Row="2" Background="#2A2A2A" BorderBrush="#3C3C3C" BorderThickness="0,1,0,0"
                    Padding="18,14">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="OK"
                            Style="{StaticResource DialogPrimaryButton}"
                            IsDefault="True"
                            IsCancel="True"
                            Click="OnOkay"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
