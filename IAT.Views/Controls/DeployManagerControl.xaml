<UserControl x:Class="IAT.Views.Controls.DeployManagerControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:IAT.ViewModels.Controls;assembly=IAT.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:DeployManagerViewModel}"
             Background="#252526"
             Foreground="#E0E0E0" IsVisibleChanged="OnIsVisibleChanged">
<!--
    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>
-->
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- Account status bar -->
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/>      <!-- Main split -->
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>   <!-- Bottom action bar -->
        </Grid.RowDefinitions>

        <!-- ═══════════════ ACCOUNT / CONNECTION BAR ═══════════════ -->
        <Border Grid.Row="0" Background="#2D2D2D" CornerRadius="6" Padding="14,10"
                BorderBrush="#3C3C3C" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Account:" Foreground="#AAAAAA" Margin="0,0,6,0"/>
                    <TextBlock Text="{Binding AccountName}" FontWeight="SemiBold" Foreground="#F7C46C"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="24,0,0,0">
                    <TextBlock Text="Storage remaining:" Foreground="#AAAAAA" Margin="0,0,6,0"/>
                    <TextBlock Text="{Binding StorageRemaining}" FontWeight="SemiBold"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="24,0,0,0">
                    <TextBlock Text="Administrations remaining:" Foreground="#AAAAAA" Margin="0,0,6,0"/>
                    <TextBlock Text="{Binding AdministrationsRemaining}" FontWeight="SemiBold"/>
                </StackPanel>

                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="24,0,16,0">
                    <Ellipse Width="8" Height="8" Margin="0,0,6,0">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="#666666"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                        <Setter Property="Fill" Value="#4CAF50"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock FontWeight="SemiBold">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="Offline"/>
                                <Setter Property="Foreground" Value="#AAAAAA"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                        <Setter Property="Text" Value="Connected"/>
                                        <Setter Property="Foreground" Value="#4CAF50"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>

                <Button Grid.Column="4" Content="Refresh" Command="{Binding RefreshCommand}"
                        Style="{StaticResource SecondaryButton}" Padding="14,6" Height="30"
                        Margin="0,0,12,0" MinWidth="72"/>

                <TextBlock Grid.Column="5" VerticalAlignment="Center" Foreground="#888888">
                    <Run Text="Last sync: "/>
                    <Run Text="{Binding LastSyncText, Mode=OneWay}"/>
                </TextBlock>
            </Grid>
        </Border>

        <!-- ═══════════════ MAIN SPLIT: LIST | PREVIEW ═══════════════ -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <!-- Reports pane prefers width so names/URLs can breathe -->
                <ColumnDefinition Width="1.55*" MinWidth="420"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="1*" MinWidth="360"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT: Deployed Tests / IAT Reports -->
            <Border Grid.Column="0" Background="#2D2D2D" CornerRadius="6" BorderBrush="#3C3C3C" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Header row: title · password · actions -->
                    <Border Grid.Row="0" BorderBrush="#3C3C3C" BorderThickness="0,0,0,1" Padding="12,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="Deployed Tests" FontSize="15" FontWeight="SemiBold"
                                       VerticalAlignment="Center" Margin="0,0,16,0"/>

                            <!-- Password for the selected IAT (auto-filled from AppData when available) -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal"
                                        VerticalAlignment="Center" Margin="0,0,12,0">
                                <TextBlock Text="Password" Foreground="#AAAAAA" FontSize="12"
                                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBox Text="{Binding SelectedIatPassword, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource DarkTextBox}"
                                         Width="160" Height="28" Padding="8,2"
                                         VerticalContentAlignment="Center"
                                         IsEnabled="{Binding SelectedDeployedTest, Converter={StaticResource NullToBool}}"
                                         ToolTip="IAT password. Auto-filled from local AppData when this machine previously deployed the test."/>
                                <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" FontSize="11"
                                           Foreground="#7CB342"
                                           ToolTip="Password was loaded from AppData for this IAT.">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value=""/>
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasStoredPassword}" Value="True">
                                                    <Setter Property="Text" Value="saved"/>
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="Retrieve" Command="{Binding RetrieveResultsCommand}"
                                        Style="{StaticResource SecondaryButton}"
                                        Margin="0,0,6,0" MinWidth="72"/>
                                <Button Content="Clear" Command="{Binding ClearResultsCommand}"
                                        Style="{StaticResource SecondaryButton}"
                                        Margin="0,0,6,0" MinWidth="60"/>
                                <Button Content="Delete" Command="{Binding DeleteTestCommand}"
                                        Style="{StaticResource DangerButton}"
                                        MinWidth="64"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- List — local item chrome (sheen cards); transparent container so cards own the surface -->
                    <ListBox Grid.Row="1" ItemsSource="{Binding DeployedTests}"
                             SelectedItem="{Binding SelectedDeployedTest}"
                             Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             Margin="6,4,6,6"
                             HorizontalContentAlignment="Stretch">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0,0,0,6"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <ContentPresenter/>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:DeployedTestItem}">
                                <!-- Dark card with top sheen; selection via outer border color -->
                                <Border x:Name="ReportCard"
                                        CornerRadius="7"
                                        BorderThickness="1"
                                        BorderBrush="#3A3A3A"
                                        Padding="{Binding ReportCellPadding, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        SnapsToDevicePixels="True">
                                    <Border.Background>
                                        <!-- Base + specular sheen along the top edge -->
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#3A3A3A" Offset="0"/>
                                            <GradientStop Color="#2A2A2A" Offset="0.08"/>
                                            <GradientStop Color="#1C1C1C" Offset="0.35"/>
                                            <GradientStop Color="#161616" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="6" ShadowDepth="1" Direction="270"
                                                          Color="#000000" Opacity="0.35"/>
                                    </Border.Effect>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                            <TextBlock Text="{Binding Name}"
                                                       FontWeight="SemiBold"
                                                       Foreground="#F0F0F0"
                                                       TextTrimming="CharacterEllipsis"
                                                       FontSize="{Binding ReportNameFontSize, RelativeSource={RelativeSource AncestorType=UserControl}}"/>

                                            <!-- Secondary: date | size | URL — hit target ends with the link text -->
                                            <Grid Margin="0,4,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding UploadedDisplay}"
                                                           Foreground="#B0B0B0"
                                                           VerticalAlignment="Center"
                                                           Margin="0,0,12,0"
                                                           FontSize="{Binding ReportMetaFontSize, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                                <TextBlock Grid.Column="1" Text="{Binding SizeDisplay}"
                                                           Foreground="#B0B0B0"
                                                           VerticalAlignment="Center"
                                                           Margin="0,0,12,0"
                                                           FontSize="{Binding ReportMetaFontSize, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                                <!-- Cell takes remaining width; button sizes to text (capped by cell) -->
                                                <Grid Grid.Column="2" x:Name="UrlCell">
                                                    <Button Command="{Binding OpenUrlCommand}"
                                                            Background="Transparent"
                                                            BorderThickness="0"
                                                            Cursor="Hand"
                                                            Padding="0"
                                                            Margin="0"
                                                            Focusable="False"
                                                            HorizontalAlignment="Left"
                                                            HorizontalContentAlignment="Left"
                                                            VerticalAlignment="Center"
                                                            MaxWidth="{Binding ActualWidth, ElementName=UrlCell}"
                                                            ToolTip="{Binding Url}">
                                                        <TextBlock Text="{Binding UrlDisplay}"
                                                                   Foreground="#64B5F6"
                                                                   TextDecorations="Underline"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   FontSize="{Binding ReportMetaFontSize, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                                    </Button>
                                                </Grid>
                                            </Grid>
                                        </StackPanel>

                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding Status}"
                                                   VerticalAlignment="Center"
                                                   Foreground="#F7C46C"
                                                   Margin="4,0,0,0"
                                                   FontSize="{Binding ReportMetaFontSize, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                    </Grid>
                                </Border>

                                <DataTemplate.Triggers>
                                    <!-- Selected: brighter sheen + accent border -->
                                    <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                        <Setter TargetName="ReportCard" Property="BorderBrush" Value="#007ACC"/>
                                        <Setter TargetName="ReportCard" Property="Background">
                                            <Setter.Value>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                    <GradientStop Color="#2A4A66" Offset="0"/>
                                                    <GradientStop Color="#1A3348" Offset="0.12"/>
                                                    <GradientStop Color="#142636" Offset="0.4"/>
                                                    <GradientStop Color="#101E2A" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Setter.Value>
                                        </Setter>
                                    </DataTrigger>
                                    <!-- Hover (when not selected) -->
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True"/>
                                            <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="False"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter TargetName="ReportCard" Property="BorderBrush" Value="#555555"/>
                                        <Setter TargetName="ReportCard" Property="Background">
                                            <Setter.Value>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                    <GradientStop Color="#484848" Offset="0"/>
                                                    <GradientStop Color="#333333" Offset="0.1"/>
                                                    <GradientStop Color="#242424" Offset="0.4"/>
                                                    <GradientStop Color="#1C1C1C" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Setter.Value>
                                        </Setter>
                                    </MultiDataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- RIGHT: Test Details & Results Preview -->
            <Border Grid.Column="2" Background="#2D2D2D" CornerRadius="6" BorderBrush="#3C3C3C" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Title + search -->
                    <Border Grid.Row="0" BorderBrush="#3C3C3C" BorderThickness="0,0,0,1" Padding="12,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Test Details &amp; Results Preview" FontSize="15" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding SelectedTestTitle}" Foreground="#AAAAAA" FontSize="12" Margin="0,2,0,0"/>
                            </StackPanel>
                            <!-- Search filters the participant rows inside the active survey tab (future CollectionView) -->
                            <TextBox Grid.Column="1" Width="180" Height="28"
                                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource DarkTextBox}"
                                     VerticalContentAlignment="Center"
                                     ToolTip="Filter participants by ID or response text within the selected survey"/>
                        </Grid>
                    </Border>

                    <!-- Content: either empty state or tabs -->
                    <Grid Grid.Row="1" Margin="8">
                        <!-- Empty when no results -->
                        <TextBlock Text="Select a deployed test that has results to preview scoring and questionnaire data."
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="#666666" FontSize="13"
                                   Visibility="{Binding HasResults, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}"/>

                        <!-- Tabs for Summary + each survey -->
                        <TabControl ItemsSource="{Binding SurveyTabs}"
                                    SelectedItem="{Binding SelectedSurveyTab}"
                                    Background="Transparent" BorderThickness="0"
                                    Visibility="{Binding HasResults, Converter={StaticResource BoolToVisibility}}">
                            <TabControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Header}" Padding="4,2"/>
                                </DataTemplate>
                            </TabControl.ItemTemplate>
                            <TabControl.ContentTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <!-- SUMMARY TAB -->
                                        <StackPanel Visibility="{Binding IsSummary, Converter={StaticResource BoolToVisibility}}">
                                            <!-- KPI cards -->
                                            <UniformGrid Columns="3" Margin="0,8,0,16">
                                                <Border Background="#1E3A2F" CornerRadius="6" Padding="16,12" Margin="0,0,8,0">
                                                    <StackPanel>
                                                        <TextBlock Text="Mean D-score" Foreground="#AAAAAA" FontSize="11"/>
                                                        <TextBlock Text="{Binding DataContext.MeanDScore, RelativeSource={RelativeSource AncestorType=UserControl}, StringFormat={}{0:0.00}}"
                                                                   FontSize="28" FontWeight="Bold" Foreground="#4CAF50" Margin="0,4,0,0"/>
                                                    </StackPanel>
                                                </Border>
                                                <Border Background="#1E2A3A" CornerRadius="6" Padding="16,12" Margin="0,0,8,0">
                                                    <StackPanel>
                                                        <TextBlock Text="N" Foreground="#AAAAAA" FontSize="11"/>
                                                        <TextBlock Text="{Binding DataContext.SampleSize, RelativeSource={RelativeSource AncestorType=UserControl}, StringFormat='N={0}'}"
                                                            FontSize="28" FontWeight="Bold" Foreground="#64B5F6" Margin="0,4,0,0"/>      
                                                    </StackPanel>
                                                </Border>
                                                <Border Background="#3A2E1E" CornerRadius="6" Padding="16,12">
                                                    <StackPanel>
                                                        <TextBlock Text="Avg RT" Foreground="#AAAAAA" FontSize="11"/>
                                                        <TextBlock Text="{Binding DataContext.AverageRtMs, RelativeSource={RelativeSource AncestorType=UserControl}, StringFormat={}{0:0}ms}"
                                                                   FontSize="28" FontWeight="Bold" Foreground="#F7C46C" Margin="0,4,0,0"/>
                                                    </StackPanel>
                                                </Border>
                                            </UniformGrid>

                                            <TextBlock Text="D-Score Distribution" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                            <Border Background="#1A1A1A" Height="120" CornerRadius="4"
                                                    BorderBrush="#3C3C3C" BorderThickness="1">
                                                <!-- Placeholder histogram — real implementation uses a chart control or custom drawing -->
                                                <TextBlock Text="[Histogram placeholder — wire to LiveCharts or custom DrawingVisual]"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           Foreground="#555555" FontSize="12"/>
                                            </Border>
                                        </StackPanel>

                                        <!-- SURVEY RESPONSE TAB -->
                                        <Grid Visibility="{Binding IsSummary, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                            </Grid.RowDefinitions>

                                            <!-- Compact headers with ToolTips for full question text -->
                                            <ScrollViewer Grid.Row="0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                                                          Margin="0,0,0,6">
                                                <ItemsControl ItemsSource="{Binding QuestionHeaders}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <StackPanel Orientation="Horizontal"/>
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Background="#333333" CornerRadius="3" Padding="8,4" Margin="0,0,4,0"
                                                                    MinWidth="90" MaxWidth="140"
                                                                    ToolTip="{Binding FullText}">
                                                                <StackPanel>
                                                                    <TextBlock Text="{Binding ShortText}" FontWeight="SemiBold" FontSize="11"
                                                                               TextTrimming="CharacterEllipsis"/>
                                                                    <TextBlock Text="{Binding ResponseType}" Foreground="#888888" FontSize="9"/>
                                                                </StackPanel>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </ScrollViewer>

                                            <!-- Scrollable participant rows -->
                                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                                <ItemsControl ItemsSource="{Binding Rows}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border BorderBrush="#333333" BorderThickness="0,0,0,1" Padding="4,6">
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="80"/>
                                                                        <ColumnDefinition Width="*"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Text="{Binding ParticipantId}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                                    <ItemsControl Grid.Column="1" ItemsSource="{Binding Values}">
                                                                        <ItemsControl.ItemsPanel>
                                                                            <ItemsPanelTemplate>
                                                                                <StackPanel Orientation="Horizontal"/>
                                                                            </ItemsPanelTemplate>
                                                                        </ItemsControl.ItemsPanel>
                                                                        <ItemsControl.ItemTemplate>
                                                                            <DataTemplate>
                                                                                <Border Background="#2A2A2A" CornerRadius="3" Padding="8,3" Margin="0,0,4,0"
                                                                                        MinWidth="90" MaxWidth="140">
                                                                                    <TextBlock Text="{Binding}" FontSize="12" TextTrimming="CharacterEllipsis"
                                                                                               ToolTip="{Binding}"/>
                                                                                </Border>
                                                                            </DataTemplate>
                                                                        </ItemsControl.ItemTemplate>
                                                                    </ItemsControl>
                                                                </Grid>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </ScrollViewer>
                                        </Grid>
                                    </Grid>
                                </DataTemplate>
                            </TabControl.ContentTemplate>
                        </TabControl>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- ═══════════════ BOTTOM ACTION BAR ═══════════════ -->
        <Grid Grid.Row="4" Margin="0,4,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Content="+ Deploy Current Test"
                    Command="{Binding DeployCurrentTestCommand}"
                    Style="{StaticResource AccentButton}"
                    HorizontalAlignment="Left" Padding="20,10" Height="40" FontSize="14"
                    MinWidth="180"/>

            <Button Grid.Column="1" Content="Download All Results"
                    Command="{Binding DownloadAllResultsCommand}"
                    Style="{StaticResource SecondaryButton}"
                    Padding="18,10" Height="40" Margin="0,0,10,0" FontSize="13"
                    MinWidth="160"/>

            <Button Grid.Column="2" Content="Delete Selected"
                    Command="{Binding DeleteSelectedCommand}"
                    Style="{StaticResource DangerButton}"
                    Padding="18,10" Height="40" FontSize="13"
                    MinWidth="130"/>
        </Grid>
    </Grid>
</UserControl>
