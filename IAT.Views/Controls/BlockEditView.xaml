<UserControl x:Class="IAT.Views.Controls.BlockEditView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:IAT.ViewModels;assembly=IAT.ViewModels"
             xmlns:controls="clr-namespace:IAT.ViewModels.Controls;assembly=IAT.ViewModels"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1200">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="280"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- LEFT: Blocks sidebar -->
        <Border Background="#1F1F1F" BorderBrush="#333" BorderThickness="0,0,1,0" Grid.Row="0" Grid.RowSpan="2">
            <DockPanel>
                <TextBlock Text="Blocks" FontSize="18" FontWeight="SemiBold" Foreground="White"
                           Margin="16,12,16,8" DockPanel.Dock="Top"/>

                <StackPanel Orientation="Vertical" Margin="12,0,12,12" DockPanel.Dock="Bottom">
                    <Button Content="+ Add Block" Command="{Binding AddBlockCommand}"
                            Style="{StaticResource AccentButton}" Height="36"
                            ToolTip="Add a practice block. Create exactly two blocks, then generate the standard 7-block IAT."/>
                    <Button Content="Generate 7-Block IAT" Command="{Binding GenerateSevenBlockIatCommand}"
                            Style="{StaticResource AccentButton}" Height="36" Margin="0,8,0,0"
                            ToolTip="Requires exactly two blocks with Left/Right response keys. Builds blocks 3–7 (compatible, reversed attribute, incompatible) and locks the structure."/>
                    <Button Content="Delete Block" Command="{Binding DeleteBlockCommand}"
                            Margin="0,8,0,0" Height="36"
                            ToolTip="Remove the selected block. Disabled once the standard 7-block structure is locked."/>
                </StackPanel>

                <ListBox ItemsSource="{Binding Blocks}" SelectedItem="{Binding SelectedBlock}"
                         Background="Transparent" BorderThickness="0" Margin="8"
                         ItemContainerStyle="{StaticResource DarkListBoxItem}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}" Foreground="#F0F0F0" FontSize="15"
                                       FontWeight="SemiBold" Margin="4,2"
                                       TextTrimming="CharacterEllipsis"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- CENTER: Live Preview Canvas (no layout chrome borders — production-like) -->
        <Grid Grid.Column="1" Margin="16" Grid.Row="0" SizeChanged="OnPreviewHostSizeChanged" x:Name="PreviewHost">

            <Border Background="White" CornerRadius="4" Padding="20" Effect="{StaticResource DropShadow}">

                <!-- LayoutViewModel is the DataContext for geometry + trial preview content -->
                <Grid DataContext="{Binding LayoutViewModel, TargetNullValue={x:Null}, FallbackValue={x:Null}}">

                    <Canvas x:Name="PreviewCanvas" Background="#F8F8F8"
                            Width="{Binding InteriorWidth}"
                            Height="{Binding InteriorHeight}"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Canvas.RenderTransform>
                            <ScaleTransform ScaleX="{Binding ScaleFactor}" ScaleY="{Binding ScaleFactor}"
                                            CenterX="{Binding InteriorWidth, Converter={StaticResource HalfValueConverter}}"
                                            CenterY="{Binding InteriorHeight, Converter={StaticResource HalfValueConverter}}" />
                        </Canvas.RenderTransform>

                        <!-- Instruction / block body text.
                             Geometry is ActiveInstructions* — switched by LayoutViewModel to:
                               TextInstructionScreen  → TextInstructionsRect
                               KeyedInstructionScreen → KeyedInstructionsRect
                               MockItemInstructionScreen → MockItemInstructionsRect
                               trial / block mode     → BlockInstructionsRect -->
                        <Border Canvas.Left="{Binding ActiveInstructionsX}"
                                Canvas.Top="{Binding ActiveInstructionsY}"
                                Width="{Binding ActiveInstructionsWidth}"
                                Height="{Binding ActiveInstructionsHeight}"
                                BorderThickness="0"
                                Background="Transparent"
                                ClipToBounds="True">
                            <!-- Top-aligned. DownOnly Viewbox keeps the authored font when it
                                 fits and scales the whole paragraph when it does not, so a
                                 large Instruction Style cannot clip or paint through the stage. -->
                            <Viewbox Stretch="Uniform" StretchDirection="DownOnly"
                                     HorizontalAlignment="Stretch" VerticalAlignment="Top"
                                     Margin="8,4">
                                <TextBlock Text="{Binding PreviewBlockInstructionsText}"
                                           FontFamily="{Binding PreviewBlockInstructionsFontFamily}"
                                           FontSize="{Binding PreviewBlockInstructionsFontSize}"
                                           Foreground="{Binding PreviewBlockInstructionsBrush}"
                                           MaxWidth="{Binding ActiveInstructionsWidth}"
                                           TextAlignment="Center"
                                           TextWrapping="Wrap"/>
                            </Viewbox>
                        </Border>

                        <!-- Stimulus Area: trial / Mock Item only — collapsed for Text & Keyed instructions -->
                        <Border Canvas.Left="{Binding StimulusX}"
                                Canvas.Top="{Binding StimulusY}"
                                Width="{Binding StimulusWidth}"
                                Height="{Binding StimulusHeight}"
                                BorderThickness="0"
                                ClipToBounds="True"
                                Background="Transparent"
                                Visibility="{Binding IsStimulusAreaVisible, Converter={StaticResource BoolToVis}}">
                            <Grid>
                                <Viewbox Stretch="Uniform" StretchDirection="DownOnly"
                                         Margin="8"
                                         Visibility="{Binding IsPreviewTextVisible, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="{Binding PreviewStimulusText}"
                                               FontFamily="{Binding PreviewStimulusFontFamily}"
                                               FontSize="{Binding PreviewStimulusFontSize}"
                                               Foreground="{Binding PreviewStimulusBrush}"
                                               FontWeight="SemiBold"
                                               TextWrapping="Wrap"
                                               TextAlignment="Center"
                                               MaxWidth="{Binding StimulusWidth}"/>
                                </Viewbox>

                                <Image Source="{Binding PreviewStimulusImage}"
                                       Stretch="Uniform"
                                       HorizontalAlignment="Stretch"
                                       VerticalAlignment="Stretch"
                                       Margin="2"
                                       Visibility="{Binding IsPreviewImageVisible, Converter={StaticResource BoolToVis}}"/>
                            </Grid>
                        </Border>

                        <!-- Left Key: Keyed / Mock / trial only — hidden for Text instruction screens -->
                        <Border Canvas.Left="{Binding LeftKeyX}"
                                Canvas.Top="{Binding LeftKeyY}"
                                Width="{Binding KeyWidth}"
                                Height="{Binding KeyHeight}"
                                Background="Transparent"
                                BorderThickness="3"
                                CornerRadius="4"
                                ClipToBounds="True"
                                Padding="4"
                                Visibility="{Binding IsResponseKeysVisible, Converter={StaticResource BoolToVis}}">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="BorderBrush" Value="Transparent"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsLeftKeyOutlined}" Value="True">
                                            <Setter Property="BorderBrush" Value="#007ACC"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Viewbox Stretch="Uniform" StretchDirection="DownOnly" Margin="2">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding LeftKeyLine1Text}"
                                               FontFamily="{Binding LeftKeyLine1FontFamily}"
                                               FontSize="{Binding LeftKeyLine1FontSize}"
                                               Foreground="{Binding LeftKeyLine1Brush}"
                                               FontWeight="{Binding LeftKeyPreviewFontWeight}"
                                               TextAlignment="Center"/>
                                    <TextBlock Text="{Binding LeftKeyOrText}"
                                               FontFamily="Segoe UI"
                                               FontSize="24"
                                               Foreground="Black"
                                               FontWeight="Normal"
                                               TextAlignment="Center"
                                               Visibility="{Binding IsLeftKeyStacked, Converter={StaticResource BoolToVis}}"/>
                                    <TextBlock Text="{Binding LeftKeyLine2Text}"
                                               FontFamily="{Binding LeftKeyLine2FontFamily}"
                                               FontSize="{Binding LeftKeyLine2FontSize}"
                                               Foreground="{Binding LeftKeyLine2Brush}"
                                               FontWeight="{Binding LeftKeyPreviewFontWeight}"
                                               TextAlignment="Center"
                                               Visibility="{Binding IsLeftKeyStacked, Converter={StaticResource BoolToVis}}"/>
                                </StackPanel>
                            </Viewbox>
                        </Border>

                        <!-- Right Key: Keyed / Mock / trial only — hidden for Text instruction screens -->
                        <Border Canvas.Left="{Binding RightKeyX}"
                                Canvas.Top="{Binding RightKeyY}"
                                Width="{Binding KeyWidth}"
                                Height="{Binding KeyHeight}"
                                Background="Transparent"
                                BorderThickness="3"
                                CornerRadius="4"
                                ClipToBounds="True"
                                Padding="4"
                                Visibility="{Binding IsResponseKeysVisible, Converter={StaticResource BoolToVis}}">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="BorderBrush" Value="Transparent"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsRightKeyOutlined}" Value="True">
                                            <Setter Property="BorderBrush" Value="#007ACC"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Viewbox Stretch="Uniform" StretchDirection="DownOnly" Margin="2">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding RightKeyLine1Text}"
                                               FontFamily="{Binding RightKeyLine1FontFamily}"
                                               FontSize="{Binding RightKeyLine1FontSize}"
                                               Foreground="{Binding RightKeyLine1Brush}"
                                               FontWeight="{Binding RightKeyPreviewFontWeight}"
                                               TextAlignment="Center"/>
                                    <TextBlock Text="{Binding RightKeyOrText}"
                                               FontFamily="Segoe UI"
                                               FontSize="24"
                                               Foreground="Black"
                                               FontWeight="Normal"
                                               TextAlignment="Center"
                                               Visibility="{Binding IsRightKeyStacked, Converter={StaticResource BoolToVis}}"/>
                                    <TextBlock Text="{Binding RightKeyLine2Text}"
                                               FontFamily="{Binding RightKeyLine2FontFamily}"
                                               FontSize="{Binding RightKeyLine2FontSize}"
                                               Foreground="{Binding RightKeyLine2Brush}"
                                               FontWeight="{Binding RightKeyPreviewFontWeight}"
                                               TextAlignment="Center"
                                               Visibility="{Binding IsRightKeyStacked, Converter={StaticResource BoolToVis}}"/>
                                </StackPanel>
                            </Viewbox>
                        </Border>

                        <!-- Error Mark (shown for Mock Item instructions with ShowErrorMark).
                             ClipToBounds + Viewbox keep the glyph inside the layout rect so a
                             large FontSize cannot paint over the stimulus above. -->
                        <Border Canvas.Left="{Binding ErrorMarkX}"
                                Canvas.Top="{Binding ErrorMarkY}"
                                Width="{Binding ErrorMarkWidth}"
                                Height="{Binding ErrorMarkHeight}"
                                BorderThickness="0"
                                Background="Transparent"
                                ClipToBounds="True"
                                Visibility="{Binding IsErrorMarkVisible, Converter={StaticResource BoolToVis}}">
                            <Viewbox Stretch="Uniform" StretchDirection="DownOnly" Margin="2">
                                <TextBlock Text="X" Foreground="Red" FontSize="48"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Viewbox>
                        </Border>

                        <!-- Continue instructions (instruction-screen preview only) -->
                        <Border Canvas.Left="{Binding ContinueInstructionsX}"
                                Canvas.Top="{Binding ContinueInstructionsY}"
                                Width="{Binding ContinueInstructionsWidth}"
                                Height="{Binding ContinueInstructionsHeight}"
                                BorderThickness="0"
                                Background="Transparent"
                                ClipToBounds="True"
                                Visibility="{Binding IsContinueInstructionsVisible, Converter={StaticResource BoolToVis}}">
                            <Viewbox Stretch="Uniform" StretchDirection="DownOnly"
                                     HorizontalAlignment="Center" VerticalAlignment="Center"
                                     Margin="8,0">
                                <TextBlock Text="{Binding PreviewContinueText}"
                                           FontSize="13" Foreground="#444"
                                           TextWrapping="Wrap" TextAlignment="Center"
                                           MaxWidth="{Binding ContinueInstructionsWidth}"/>
                            </Viewbox>
                        </Border>
                    </Canvas>
                </Grid>
            </Border>
        </Grid>

        <!-- RIGHT: Properties -->
        <Border Grid.Column="2" Background="#1F1F1F" Padding="16">
            <StackPanel>
                <TextBlock Text="Block Properties" FontSize="16" FontWeight="SemiBold"
                           Foreground="White" Margin="0,0,0,16"/>

                <Label Content="Number of Presentations" Foreground="White" Margin="0,12,0,0"/>
                <TextBox Text="{Binding SelectedBlock.NumPresentations, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         Background="#2D2D2D" Foreground="#E0E0E0" BorderBrush="#555555"
                         Padding="8,6" Height="32"
                         ToolTip="How many presentations to administer in this block. Defaults: 10 on blocks 1, 2, 3, 5, 6; 20 on blocks 4 and 7."/>

                <Label Content="Instructions Text" Foreground="White" Margin="0,12,0,0"/>
                <TextBox Text="{Binding BlockInstructionsText, UpdateSourceTrigger=PropertyChanged}"
                         AcceptsReturn="True" TextWrapping="Wrap" Height="72"
                         IsEnabled="{Binding IsBlockInstructionsEditable}"
                         Background="#2D2D2D" Foreground="#E0E0E0" BorderBrush="#555555"
                         ToolTip="Block-level instructions shown with trials. Required for export — blank or the placeholder “Block Instructions” fails validation. Disabled while an instruction screen (I#) is selected — edit those on the Instructions tab."/>

                <!-- Basic formatting for the block-instructions FormattedText (export + slide render consume Style). -->
                <TextBlock Text="Instruction Style" Foreground="#AAAAAA" FontSize="11" Margin="0,10,0,4"/>
                <Grid IsEnabled="{Binding IsBlockInstructionsEditable}" Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="72"/>
                    </Grid.ColumnDefinitions>
                    <ComboBox Grid.Column="0"
                              ItemsSource="{Binding AvailableFontFamilies}"
                              SelectedItem="{Binding InstructionFontFamily}"
                              Style="{StaticResource DarkComboBox}"
                              Height="28"
                              ToolTip="Font family for block instructions"/>
                    <ComboBox Grid.Column="2"
                              ItemsSource="{Binding AvailableFontSizes}"
                              SelectedItem="{Binding InstructionFontSize}"
                              Style="{StaticResource DarkComboBox}"
                              Height="28"
                              ToolTip="Font size for block instructions"/>
                </Grid>
                <WrapPanel IsEnabled="{Binding IsBlockInstructionsEditable}" Margin="0,2,0,0">
                    <Button Width="22" Height="22" Margin="1" Background="#000000" BorderBrush="#555"
                            Command="{Binding ApplyInstructionPaletteCommand}" CommandParameter="Black"
                            ToolTip="Black"/>
                    <Button Width="22" Height="22" Margin="1" Background="#FFFFFF" BorderBrush="#555"
                            Command="{Binding ApplyInstructionPaletteCommand}" CommandParameter="White"
                            ToolTip="White"/>
                    <Button Width="22" Height="22" Margin="1" Background="#CD212A" BorderBrush="#555"
                            Command="{Binding ApplyInstructionPaletteCommand}" CommandParameter="Flame Scarlet"
                            ToolTip="Flame Scarlet"/>
                    <Button Width="22" Height="22" Margin="1" Background="#00A1B4" BorderBrush="#555"
                            Command="{Binding ApplyInstructionPaletteCommand}" CommandParameter="Bluebird"
                            ToolTip="Bluebird"/>
                    <Button Width="22" Height="22" Margin="1" Background="#009473" BorderBrush="#555"
                            Command="{Binding ApplyInstructionPaletteCommand}" CommandParameter="Emerald"
                            ToolTip="Emerald"/>
                    <Button Width="22" Height="22" Margin="1" Background="#5F4B8B" BorderBrush="#555"
                            Command="{Binding ApplyInstructionPaletteCommand}" CommandParameter="Ultra Violet"
                            ToolTip="Ultra Violet"/>
                    <Button Width="22" Height="22" Margin="1" Background="#FF3EA5" BorderBrush="#555"
                            Command="{Binding ApplyInstructionPaletteCommand}" CommandParameter="Knockout Pink"
                            ToolTip="Knockout Pink"/>
                    <Button Width="22" Height="22" Margin="1" Background="#EA6759" BorderBrush="#555"
                            Command="{Binding ApplyInstructionPaletteCommand}" CommandParameter="Ember Glow"
                            ToolTip="Ember Glow"/>
                    <Border Width="22" Height="22" Margin="4,1,1,1"
                            BorderBrush="#888" BorderThickness="1"
                            Background="{Binding InstructionPreviewBrush}"
                            ToolTip="Current instruction color"/>
                </WrapPanel>
            </StackPanel>
        </Border>

        <!-- BOTTOM: Sequence grid — instructions first, then trials; selection drives preview -->
        <Grid Grid.Column="1" Grid.ColumnSpan="2" Grid.Row="1" Margin="16,0,16,16"
              VerticalAlignment="Bottom" Height="200">
            <Border Background="#1F1F1F" CornerRadius="4">
                <DockPanel>
                    <TextBlock Text="Sequence — instructions (I#) appear first; select a row to preview"
                               Foreground="#AAAAAA" FontSize="11"
                               Margin="12,8,12,4" DockPanel.Dock="Top"/>
                    <DataGrid ItemsSource="{Binding SequenceRows}"
                              SelectedItem="{Binding SelectedSequenceRow, Mode=TwoWay}"
                              AutoGenerateColumns="False"
                              Background="Transparent"
                              RowBackground="Transparent"
                              AlternatingRowBackground="#2A2A2A"
                              Foreground="#E0E0E0"
                              HeadersVisibility="Column"
                              IsReadOnly="True"
                              SelectionMode="Single"
                              SelectionUnit="FullRow"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              CanUserSortColumns="False"
                              GridLinesVisibility="Horizontal"
                              BorderThickness="0"
                              Margin="4">
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#252526"/>
                                <Setter Property="Foreground" Value="#E0E0E0"/>
                                <Setter Property="BorderBrush" Value="#3C3C3C"/>
                                <Setter Property="BorderThickness" Value="0,0,1,1"/>
                                <Setter Property="Padding" Value="10,8"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="FontSize" Value="12"/>
                                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsInstruction}" Value="True">
                                        <Setter Property="Foreground" Value="#F7C46C"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Trial #" Binding="{Binding NumberDisplay}" Width="70">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsInstruction}" Value="True">
                                                <Setter Property="Foreground" Value="#F7C46C"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Detail" Binding="{Binding Detail}" Width="*"/>
                            <DataGridTextColumn Header="Type / Direction" Binding="{Binding DirectionDisplay}" Width="120"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
